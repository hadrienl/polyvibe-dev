<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- device-bridge (#527) reads the iPhone's screen, a camera to macOS. tccd also wants this entitlement on the
     responsible process, the application: without it, the request is refused without a prompt. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
