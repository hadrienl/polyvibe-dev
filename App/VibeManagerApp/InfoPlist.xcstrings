    "NSDesktopFolderUsageDescription" : {
      "comment" : "Why the application asks for access to the Desktop.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح Polyvibe لوكيل البرمجة الذي شغّلته قراءة المجلد الذي اخترته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe erlaubt dem von dir gestarteten Coding-Agent, den gewählten Ordner zu lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Polyvibe lets the coding agent you launched read the folder you chose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe permite que el agente de código que has abierto lea la carpeta que has elegido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe permet à l’agent de code que vous avez lancé de lire le dossier que vous avez choisi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe आपके द्वारा लॉन्च किए गए कोडिंग एजेंट को आपका चुना हुआ फ़ोल्डर पढ़ने देता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe consente all’agente di programmazione che hai avviato di leggere la cartella che hai scelto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibeは、起動したコーディングエージェントが選択したフォルダを読み取れるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe는 사용자가 실행한 코딩 에이전트가 사용자가 선택한 폴더를 읽을 수 있도록 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe laat de codeeragent die je hebt gestart de door jou gekozen map lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe pozwala uruchomionemu przez Ciebie agentowi kodującemu czytać wybrany folder."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Polyvibe permite que o agente de código que você abriu leia a pasta que você escolheu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe позволяет запущенному вами агенту для программирования читать выбранную вами папку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe, başlattığınız kodlama ajanının seçtiğiniz klasörü okumasına izin verir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe дозволяє запущеному вами агенту для програмування читати вибрану вами папку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe 让你启动的编程智能体读取你选择的文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe 讓你啟動的程式碼代理程式讀取你所選的資料夾。"
          }
        }
      }
    },
