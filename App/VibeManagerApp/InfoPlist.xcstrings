    "NSFileProviderDomainUsageDescription" : {
      "comment" : "Why the application asks for access to iCloud Drive.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح Polyvibe مجلد العمل الذي اخترته في iCloud Drive."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe öffnet den gewählten Arbeitsordner in iCloud Drive."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Polyvibe opens the working folder you chose in iCloud Drive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe abre la carpeta de trabajo que has elegido en iCloud Drive."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe ouvre le dossier de travail que vous avez choisi dans iCloud Drive."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe iCloud Drive में आपके द्वारा चुना गया कार्य फ़ोल्डर खोलता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe apre la cartella di lavoro che hai scelto in iCloud Drive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibeは、iCloud Driveで選択した作業フォルダを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe는 사용자가 선택한 iCloud Drive의 작업 폴더를 엽니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe opent de werkmap die je in iCloud Drive hebt gekozen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe otwiera wybrany przez Ciebie folder roboczy na iCloud Drive."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Polyvibe abre a pasta de trabalho que você escolheu no iCloud Drive."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe открывает выбранную вами рабочую папку в iCloud Drive."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe, iCloud Drive’da seçtiğiniz çalışma klasörünü açar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe відкриває вибрану вами робочу папку в iCloud Drive."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe 会打开你在 iCloud 云盘中选择的工作文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe 會打開你在 iCloud 雲碟中所選的工作資料夾。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Why the application asks to reach the local network.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتصل Polyvibe بخوادم النماذج التي أضفتها على شبكتك المحلية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe erreicht die Modellserver, die du in deinem lokalen Netzwerk angegeben hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Polyvibe reaches the model servers you declared on your local network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe se conecta a los servidores de modelos que has declarado en tu red local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe joint les serveurs de modèles que vous avez déclarés sur votre réseau local."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe आपके लोकल नेटवर्क पर आपके द्वारा घोषित मॉडल सर्वर से जुड़ता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe raggiunge i server di modelli che hai dichiarato sulla rete locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibeは、ローカルネットワーク上に登録したモデルサーバに接続します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe는 로컬 네트워크에 등록한 모델 서버에 연결합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe maakt verbinding met de modelservers die je op je lokale netwerk hebt opgegeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe łączy się z serwerami modeli zadeklarowanymi w Twojej sieci lokalnej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Polyvibe acessa os servidores de modelos que você declarou na sua rede local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe подключается к указанным вами серверам моделей в вашей локальной сети."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe, yerel ağınızda tanımladığınız model sunucularına bağlanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe звертається до серверів моделей, які ви вказали у своїй локальній мережі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe 会连接你在本地网络上声明的模型服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe 會連線至你在區域網路上設定的模型伺服器。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Why the application asks for the microphone: to dictate a message, or a page of the web view wants it.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Polyvibe الميكروفون عندما تُملي رسالة، تُنسخ على هذا الـ Mac، وعندما تطلبه منك صفحة في عرض الويب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe verwendet das Mikrofon, wenn du eine Nachricht diktierst – sie wird auf diesem Mac transkribiert – und wenn eine Seite in der Webansicht danach fragt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Polyvibe uses the microphone when you dictate a message, transcribed on this Mac, and when a page in the web view asks you for it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe usa el micrófono cuando dictas un mensaje, transcrito en este Mac, y cuando una página de la vista web te lo pide."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe utilise le micro quand vous dictez un message, transcrit sur ce Mac, et quand une page de la vue web vous le demande."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आप कोई संदेश बोलकर लिखते हैं, जिसे इसी Mac पर लिप्यंतरित किया जाता है, और जब वेब दृश्य का कोई पेज आपसे माँगता है, तब Polyvibe माइक्रोफ़ोन का उपयोग करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe usa il microfono quando detti un messaggio, trascritto su questo Mac, e quando una pagina della vista web te lo chiede."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibeは、メッセージを音声入力するとき（このMacで文字起こし）と、Webビューのページが要求したときにマイクを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe는 메시지를 받아쓸 때(이 Mac에서 변환)와 웹 보기의 페이지가 요청할 때 마이크를 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe gebruikt de microfoon wanneer je een bericht dicteert, uitgeschreven op deze Mac, en wanneer een pagina in de webweergave daarom vraagt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe używa mikrofonu, gdy dyktujesz wiadomość, transkrybowaną na tym Macu, oraz gdy prosi o to strona w widoku www."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Polyvibe usa o microfone quando você dita uma mensagem, transcrita neste Mac, e quando uma página da visualização web pede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe использует микрофон, когда вы диктуете сообщение (оно распознаётся на этом Mac) и когда его запрашивает страница в веб-панели."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe, bu Mac'te yazıya dökülen bir mesajı dikte ettiğinizde ve web görünümündeki bir sayfa sizden istediğinde mikrofonu kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe використовує мікрофон, коли ви диктуєте повідомлення (воно розпізнається на цьому Mac) і коли сторінка у вебперегляді запитує його."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你听写消息（在这台 Mac 上转写）以及网页视图中的页面请求使用麦克风时，Polyvibe 会使用麦克风。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當你聽寫訊息（在這台 Mac 上轉寫）以及網頁視圖中的頁面要求使用麥克風時，Polyvibe 會使用麥克風。"
          }
        }
      }
    },
    "NSNetworkVolumesUsageDescription" : {
      "comment" : "Why the application asks for access to a network volume.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح Polyvibe مجلد العمل الذي اخترته على وحدة التخزين هذه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe öffnet den gewählten Arbeitsordner auf diesem Volume."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Polyvibe opens the working folder you chose on this volume."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe abre la carpeta de trabajo que has elegido en este volumen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe ouvre le dossier de travail que vous avez choisi sur ce volume."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe इस वॉल्यूम पर आपके द्वारा चुना गया कार्य फ़ोल्डर खोलता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe apre la cartella di lavoro che hai scelto su questo volume."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibeは、このボリューム上で選択した作業フォルダを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe는 이 볼륨에서 사용자가 선택한 작업 폴더를 엽니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe opent de werkmap die je op dit volume hebt gekozen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe otwiera wybrany przez Ciebie folder roboczy na tym woluminie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Polyvibe abre a pasta de trabalho que você escolheu neste volume."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe открывает выбранную вами рабочую папку на этом томе."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe, bu bölümde seçtiğiniz çalışma klasörünü açar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe відкриває вибрану вами робочу папку на цьому томі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe 会打开你在此宗卷上选择的工作文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polyvibe 會打開你在此卷宗上所選的工作資料夾。"
          }
        }
      }
    },
